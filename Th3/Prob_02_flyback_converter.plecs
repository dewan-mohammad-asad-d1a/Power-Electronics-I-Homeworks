Plecs {
  Name          "Prob_02_flyback_converter"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "0.01"
  Timeout       ""
  Solver        "dopri"
  MaxStep       "1e-6"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-5"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "2"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "2"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "\nVin  = 100;          % input voltage [V]\nVo   = 2"
"8;           % output voltage [V]\nIo   = 10;           % load current [A]\nf"
"s   = 200e3;        % switching frequency [Hz]  (confirm for your flyback)\nT"
"s   = 1/fs;         % switching period [s]\nRload = Vo/Io;       % load resis"
"tance [Ohm] = 2.8\nIin  = Vo*Io/Vin;    % average input current [A] = 2.8\n\n"
"\n% ---------------- Turns ratio for this run ----------------\nn_opt   = 0.5"
"6;               \nn_scale = 0.9\nn = n_opt * n_scale\n\n% ---------------- B"
"oundary design ----------------\nD     = Vo/(Vo + n*Vin);        % duty ratio"
"\nIpk   = 2*Iin/D;                % primary peak current [A] = 5.6/D\nLm    ="
" Vin*D*Ts/Ipk;           % boundary magnetizing inductance [H] (primary side)"
"\nV_BD  = Vin + Vo/n;             % switch blocking voltage [V]\nk_R  = 0.004"
"e-3;     % Ron = k_R * V_BD^2 [Ohm/V^2]\nRon   = k_R*V_BD^2;             % MO"
"SFET on-resistance [Ohm]"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
  MatrixSignificanceCheck "2"
