Plecs {
  Name          "BuckBoost_freq_domain"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1"
  Timeout       ""
  Solver        "dopri"
  MaxStep       "1e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-3"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "2"
  DatatypeOverflowMsg "2"
  DatatypeInheritanceConflictMsg "1"
  ContSampleTimeConflictMsg "1"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "2"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% ---------- Parameters (your original notation) ---"
"-------\nf      = 900e3;\nLo     = 200e-6;\nCo     = 200e-6;\nesr    = 0.008;"
"\nR_load = 10;\n\nVin  = 20;          % Input voltage (V)\nVout = 30;        "
"  % Desired output magnitude (V)\nD = Vout / (Vin + Vout);\n\n% ---------- He"
"lper ----------\nDp = 1 - D;         % D' = complementary duty ratio\n\n% ---"
"------- Operating point ----------\nIL = D*Vin*(R_load+esr)/(R_load*Dp*(Dp*R_"
"load+esr));   % 7.412 A\nVC = -D*Vin*(R_load+esr)/(Dp*R_load+esr);           "
"   % -29.65 V\n\n% ---------- Common denominator ----------\na2 = (R_load+esr"
")^2*Lo*Co;\na1 = (R_load+esr)*(Lo + Dp*R_load*esr*Co);\na0 = R_load*Dp*(Dp*R_"
"load+esr);\nK  = Dp*(Dp*R_load+esr);\nden = [a2 a1 a0];\n\n% ---------- G_id "
"= i_L / d ----------\nnum_id = Vin*(R_load+esr)/K * [(R_load+esr)*(Dp*R_load+"
"esr)*Co, (1-D^2)*R_load + esr];\n\n% ---------- G_vd = v_o / d ----------\ng "
"     = -Vin*(R_load+esr)^2/K;\nnum_vd = g * [-esr*Co*D*Lo, esr*Co*Dp^2*R_load"
" - D*Lo, Dp^2*R_load];\n\nVo_ref = 12\nKc = 4551\nwz = 6492\nwp = 608108"
  InitialState  "1"
  SystemState   ""
  JacobianComputation "2"
  TaskingMode   "1"
